    .review-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 28px; }
    .review-card {
      padding: 24px; border-radius: var(--radius-lg); background: var(--card);
      border: 1px solid rgba(231,222,213,0.88); box-shadow: var(--shadow-soft);
      display: flex; flex-direction: column; gap: 13px;
    }
