    }
    /* LOKALNIE + ZAUFANIE + OPINIE + OBSZAR (uzupełnienie treści) */
    .local .container { max-width: 900px; }
    .local p { color: var(--muted); line-height: 1.75; font-size: 17px; margin: 0 0 16px; }
    .local p:last-child { margin-bottom: 0; }

    .trust-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 28px; }
    .trust-item {
      padding: 20px; border-radius: var(--radius-md); background: var(--card);
