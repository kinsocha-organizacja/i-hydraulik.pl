---
import PoradnikLayout from "../../layouts/PoradnikLayout.astro";

const title = "Jak zakręcić wodę w mieszkaniu? Gdzie szukać zaworu";
const h1 = "Jak zakręcić wodę w mieszkaniu i gdzie szukać zaworu?";
const description =
  "Zawór odcinający wodę w całym mieszkaniu jest przy wodomierzu: w wielkiej płycie w łazience i w kuchni, w nowym budynku w szachcie na korytarzu.";

const faq = [
  {
    q: "Gdzie jest zawór główny wody w mieszkaniu w bloku?",
    a: "Przy wodomierzu. W blokach z wielkiej płyty wodomierze są w łazience za panelem przy umywalce, wannie albo misce WC oraz osobno w kuchni, zwykle pod zlewem. W nowych budynkach są w zamykanym szachcie na korytarzu, na piętrze mieszkania.",
  },
  {
    q: "W którą stronę zakręca się zawór wody?",
    a: "Pokrętło kręci się w prawo, zgodnie z ruchem wskazówek zegara, aż do oporu. Dźwignię zaworu kulowego ustawia się w poprzek rury.",
  },
  {
    q: "Czy przed wyjazdem zakręcać wodę w mieszkaniu?",
    a: "Tak, jeśli zawory przy wodomierzach zamykają się bez dużego oporu. Gdy podczas nieobecności pęknie wężyk przy baterii albo przy pralce, z instalacji wypłynie tylko woda, która została w rurach. Zaworu, który stawia duży opór, nie zamykaj na siłę przed samym wyjazdem. Zgłoś go wcześniej administracji.",
  },
  {
    q: "Zakręciłem zawór przy wodomierzu, a woda dalej leci. Co robić?",
    a: "Sprawdź, czy zamknięte są oba zawory, zimnej i ciepłej wody, a w bloku z wielkiej płyty także zawory w drugim pomieszczeniu. Jeśli wszystkie są zamknięte, a woda leci, zawór przepuszcza albo wyciek jest przed nim. Dzwoń wtedy do administracji albo do pogotowia technicznego budynku.",
  },
  {
    q: "Czy mogę sam zamknąć wodę na pionie w piwnicy?",
    a: "Nie. Zawór pionu odcina wodę wielu mieszkaniom i obsługuje go administracja budynku. Gdy woda w mieszkaniu jest już zamknięta i trzeba naprawić to, co ciekło, zadzwoń: 511 323 123.",
  },
];

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  author: { "@type": "Organization", name: "i Hydraulik" },
  publisher: {
    "@type": "Organization",
    name: "i Hydraulik",
    logo: { "@type": "ImageObject", url: "https://i-hydraulik.pl/favicon.svg" },
  },
